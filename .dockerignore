# Version control history — must never end up in a served image
.git
.gitignore

# Database dumps / schema / seed data — not needed at runtime, and
# seed.sql contains default account emails + bcrypt hashes
database/*.sql
database/hash-password.php

# Docs and editor config — no runtime purpose
docs/
.vscode/

# OS cruft
.DS_Store
Thumbs.db

# Anything already excluded from git shouldn't ship either
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/.htaccess

# Internal notes, previews and leftovers — nothing at runtime reads or links them
# (audit B-03/B-17). composer.json/composer.lock must stay: the build runs
# `composer install` after copying the project.
database_cleanup/
**/*.md
email-preview.html
**/*.log
/database.sqlite

# Build files: still read by Docker, just not copied into the served directory
Dockerfile
.dockerignore
