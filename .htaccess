# PARISHHUB — Apache configuration (root)
Options -Indexes

# Block direct web access to any log or debug files that may appear in this directory.
<FilesMatch "\.(log|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Legacy MySQL installer. PostgreSQL/Supabase deployments must never expose
# this reset-capable setup route, even if the file remains in the repository.
<Files "install.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Build and dependency metadata. composer.json/composer.lock must stay in the
# image for `composer install`, so they are denied here instead (audit B-17).
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|Dockerfile|\.dockerignore|\.env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Internal file types that are never served (database scripts, notes, dev
# leftovers). Not JSON: the app's JSON responses all come from .php endpoints.
<FilesMatch "\.(sql|sqlite3?|db|md|mjs|lock|bak|old|orig|swp|dist|sh|ya?ml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Composer's vendor/ (generated inside the web root at build time) and the
# database cleanup notes. PHP reads vendor/ from disk; no browser ever needs it.
# Checked on both the URL and the resolved file so encoded, repeated-slash or
# mixed-case URL forms cannot reach them (audit B-03/B-17).
<IfModule mod_authz_core.c>
    <If "%{REQUEST_URI} =~ m#^/+(vendor|database_cleanup)(/|$)#i || %{REQUEST_FILENAME} =~ m#/var/www/html/(vendor|database_cleanup)(/|$)#">
        Require all denied
    </If>
</IfModule>

# Security Headers to prevent Clickjacking, MIME-sniffing, and XSS
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
